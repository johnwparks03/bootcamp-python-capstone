# Copy this file to .env and fill in real values. .env is gitignored.

# Required: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides — sensible defaults live in config.py if unset
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/embedding-001
CHROMA_PERSIST_DIR=chroma_db
SQLITE_DB_PATH=data/seed.db
LOG_LEVEL=INFO
